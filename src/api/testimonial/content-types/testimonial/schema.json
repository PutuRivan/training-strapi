    "client_name": {
      "type": "string",
      "required": true
    },
    "client_position": {
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "testimonial": {
      "type": "text",
      "required": true
    },
    "client_photo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "company_logo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "rating": {
      "type": "integer",
      "required": true,
      "min": 1,
      "max": 5
    }
  }
